# Bunu .env adı ilə kopyalayın:  cp .env.example .env
# Dəyərləri dəyişin! Real/paylaşılan mühitdə bu nümunə dəyərləri istifadə etməyin.

# --- PostgreSQL (docker compose bu dəyərlərdən istifadə edir) ---
POSTGRES_USER=bakuflow
# Parol DATABASE_URL-ə daxil edilir: yalnız hərf/rəqəm istifadə edin (@ / : # ? kimi simvollar URL-i pozur)
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=bakuflow
# Host-dan PostgreSQL-ə qoşulmaq istəsəniz (yalnız 127.0.0.1-ə bağlanır)
DB_HOST_PORT=5433

# --- Backend ---
# Anonim sessiya identifikatorlarını hash-ləmək üçün gizli açar (uzun təsadüfi mətn)
SESSION_HASH_SECRET=CHANGE_ME_long_random_string
# Demo idarəetmə endpointləri (ssenari/sıfırlama). Paylaşılan serverdə false edin.
DEMO_ENDPOINTS_ENABLED=true
# Vergüllə ayrılmış brauzer mənşələri (mobil tətbiq üçün lazım deyil)
CORS_ORIGINS=
# Backend-in 5 saniyəlik simulyator/analiz dövrü
SIM_AUTOSTART=true

# --- İstəyə bağlı: demo qaydalarını dəyişmək (default-lar config.py-dədir) ---
# HIGH_CROWD_MINUTES=10
# CROWD_WINDOW_MINUTES=5
# REPORT_COOLDOWN_SECONDS=60
